# ==============================================================================
# AutoHub Backend Environment Configuration Template
# Copy this file to .env and provide your environment-specific credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/autohub?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ------------------------------------------------------------------------------
# API Rate Limiter
# Maximum allowed requests per time window (per authenticated user or per IP)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# Automation Bot Ingestion (WhatsApp / AI bot)
# ------------------------------------------------------------------------------
AUTOMATION_BOT_API_KEY=your_automation_bot_secret_key_here
AUTOMATION_BOT_EMAIL=bot@autohubexpress.us

# ------------------------------------------------------------------------------
# Wix eCommerce Integration
# ------------------------------------------------------------------------------
WIX_API_KEY=your_wix_api_key_here
WIX_SITE_ID=your_wix_site_id_here
PART_SYNC_SECRET=your_wix_velo_part_sync_secret
WIX_VELO_BASE_URL=https://your-wix-site.com
WIX_SYNC_CONCURRENCY=2

# ------------------------------------------------------------------------------
# SendGrid Email Integration
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# ------------------------------------------------------------------------------
# eBay Integration & Motors Catalog Sync (Optional / Production)
# ------------------------------------------------------------------------------
EBAY_ENVIRONMENT=PRODUCTION
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_DEV_ID=your_ebay_dev_id
EBAY_RUNAME=your_ebay_runame
EBAY_REDIRECT_URI=https://api.autohubexpress.us/api/ebay/oauth/callback
EBAY_REST_MARKETPLACE_ID=EBAY_MOTORS_US
EBAY_MERCHANT_LOCATION_KEY=default_warehouse

# ------------------------------------------------------------------------------
# Social Lead Generation Webhooks (Optional)
# ------------------------------------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_meta_verify_token
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# ------------------------------------------------------------------------------
# eBay Message Sync (Marketplace Inbox, all optional)
# ------------------------------------------------------------------------------
# DISABLE_EBAY_MESSAGE_SYNC=false
# EBAY_MESSAGE_SYNC_SCHEDULE=*/5 * * * *
# EBAY_MESSAGE_SYNC_MAX_PAGES=3
# EBAY_MESSAGE_SYNC_MAX_DETAILS=20
# EBAY_MESSAGE_SYNC_TIME_BUDGET_MS=90000
# EBAY_MESSAGE_SYNC_DEEP_SCAN_EVERY=6
