# eBay Integration
# ===========================================================
# Get these from https://developer.ebay.com/
# Sign in to the eBay Developer Program
# Application Keys → Production (or Sandbox)
# eBay Application (OAuth)
EBAY_CLIENT_ID=RTXRECYC-CRM-SBX-862901719-9c731f85
EBAY_CLIENT_SECRET=SBX-62901719a16d-34c4-4380-9b95-7dc5
