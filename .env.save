# Meta / WhatsApp Integration
# -----------------------------------------------------------
# Get these from https://developers.facebook.com/apps/
# Create a Meta App, then go to App Dashboard → Settings → Basic
META_APP_ID=
META_APP_SECRET=
# The URL Meta redirects users to after OAuth consent
# Must match what's configured in the Meta App's "Valid OAuth Redirect URIs"
META_REDIRECT_URI=http://localhost:5000/api/integrations/whatsapp/callback
# A random string used to verify webhook endpoints
