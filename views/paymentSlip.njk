<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Payment Slip - {{ carIntake.vin }}</title>
    <style>
      /* Print page config (US Letter) */
      @page { size: Letter portrait; margin: 0.5in; }
      @media print {
        /* Ensure the document uses full page box and remove default margins */
        html, body { margin:0; padding:0 }
        /* Page container should match printable box (8.5in - 1in margins = 7.5in) */
        .page { box-shadow: none; border: none; margin: 0; padding: 0 }
      }

      /* Visual system */
      :root{
        --bg: #f7f9fb;
        --card: #ffffff;
        --muted: #6b7280;
        --text: #0f172a;
        --accent: #0956d1; /* modern blue */
        --accent-2: #eef6ff;
        --border: #e6eefc;
      }

  body{
    font-family: Inter, 
    system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; 
    color:var(--text); 
    
    margin:0; 
    padding:0; 
    -webkit-print-color-adjust:exact;
    }
  /* Page container sized to printable area (7.5in) and provides small page padding visually */
  .page{width:7.5in; max-width:7.5in; margin:0 auto; padding:0.15in; box-sizing:border-box; display:flex; align-items:stretch}
  /* Card is the actual slip and should fill the page container exactly */
  .card{width:100%; box-sizing:border-box; background:var(--card); border-radius:8px; box-shadow:0 6px 18px rgba(15,23,42,0.06); padding:16px; border:1px solid var(--border); display:flex; flex-direction:column}

  /* Make the main content area flexible so footer stays at bottom */
  .card .two-col, .card .transaction { flex: 0 0 auto }
  .card .content-spacer { flex:1 1 auto }

      /* Header */
      .header{display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:18px}
  .brand{display:flex; gap:12px; align-items:center}
      h1{font-size:18px; margin:0}
      .subtitle{color:var(--muted); font-size:12px}
      .vin{font-size:16px; font-weight:700; color:var(--accent)}

      .meta{ text-align:right; min-width:160px }
      .meta .date{font-weight:600}
      .muted{color:var(--muted); font-size:13px}

      /* Two column responsive */
      .two-col{display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-bottom:16px}
      .col{background:var(--accent-2); padding:12px; border-radius:8px}
      .col h3{margin:0 0 8px 0; font-size:13px}

      /* key/value list */
      .kv{display:grid; grid-template-columns: 120px 1fr; gap:6px 12px; align-items:start}
      .kv .k{font-weight:600; color:var(--muted); font-size:13px}
      .kv .v{font-size:13px}

      /* Transaction block */
      .transaction{margin-top:8px; background:linear-gradient(180deg,var(--card), #fcfdff); border-radius:8px; padding:12px; border:1px solid var(--border)}
      .transaction .line{display:flex; justify-content:space-between; gap:12px; align-items:center; padding:8px 0; border-bottom:1px dashed #eef4ff}
      .transaction .line:last-child{border-bottom:0}
      .amount{font-size:20px; font-weight:700; color:var(--accent)}
      .label{color:var(--muted); font-size:13px}

      /* Footer */
      .footer{margin-top:18px; font-size:13px; color:var(--muted); display:flex; justify-content:space-between; gap:8px}

      /* Print friendly tweaks */
      @media (max-width:720px){ .two-col{grid-template-columns:1fr} .meta{text-align:left} }
      /* Print-specific compaction to keep content to a single page when possible */
      @media print {
        .page { width:7.5in; padding:0 }
        .card { padding: 0.18in; box-shadow: none; border-radius: 0 }
        h1 { font-size: 16px }
        .kv .k, .kv .v, .label, .muted { font-size: 12px }
        .two-col { gap: 8px }
        .col { padding:8px }
        .transaction { padding:8px }
        .footer { margin-top:10px }
      }
      table{width:100%; border-collapse:collapse}
      .desc{white-space:pre-wrap}
    </style>
  </head>
  <body>
    <div class="page">
      <div class="card" role="document">
        <header class="header">
          <div class="brand">
            <div>
              <h1>AutoHub Payment Slip</h1>
              <div class="subtitle">Official receipt for vehicle intake</div>
              <div style="margin-top:8px">
                <div class="muted">VIN</div>
                <div class="vin">{{ carIntake.vin }}</div>
              </div>
            </div>
          </div>

          <div class="meta">
            <div class="muted">Generated</div>
            <div class="date">{{ generatedAt | usDate }}</div>
            <div style="margin-top:8px" class="muted">Slip ID</div>
            <div>{{ carIntake._id }}</div>
          </div>
        </header>

        <section class="two-col">
          <div class="col">
            <h3>Car Details</h3>
            <div class="kv">
              <div class="k">Make</div><div class="v">{{ carIntake.carDetails.make or '-' }}</div>
              <div class="k">Model</div><div class="v">{{ carIntake.carDetails.model or '-' }}</div>
              <div class="k">Year</div><div class="v">{{ carIntake.carDetails.year or '-' }}</div>
              <div class="k">Trim</div><div class="v">{{ carIntake.carDetails.trim or '-' }}</div>
              <div class="k">Color</div><div class="v">{{ carIntake.carDetails.color or '-' }}</div>
              <div class="k">Body</div><div class="v">{{ carIntake.carDetails.bodyClass or '-' }}</div>
            </div>
          </div>

          <div class="col">
            <h3>Seller Details</h3>
            <div class="kv">
              <div class="k">Name</div><div class="v">{{ carIntake.kyc.seller.firstName }} {{ carIntake.kyc.seller.lastName }}</div>
              <div class="k">Phone</div><div class="v">{{ carIntake.kyc.seller.mobileNo or '-' }}</div>
              <div class="k">Email</div><div class="v">{{ carIntake.kyc.seller.email or '-' }}</div>
              <div class="k">Notes</div><div class="v desc">{{ carIntake.kyc.seller.description or '-' }}</div>
            </div>
          </div>
        </section>

  <section class="transaction">
          <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:8px">
            <div>
              <div class="label">Transaction</div>
              <div style="font-weight:700">{{ transaction?.paymentMethod or transaction?.type or '—' }}</div>
            </div>
            <div style="text-align:right">
              <div class="label">Amount</div>
              <div class="amount">{% if transaction %}{{ transaction.amount | usCurrency }}{% else %}-{% endif %}</div>
            </div>
          </div>

          {% if transaction %}
          <div class="line">
            <div style="flex:1">
              <div class="label">Status</div>
              <div>{{ transaction.status or '-' }}</div>
            </div>
            <div style="flex:1">
              <div class="label">Date</div>
              <div>{{ transaction.createdAt | usDate }}</div>
            </div>
            <div style="flex:2">
              <div class="label">Description</div>
              <div class="desc">{{ transaction.description or transaction.paymentDescription or '-' }}</div>
            </div>
          </div>
          {% else %}
          <div class="muted">No transaction found for this intake.</div>
          {% endif %}
        </section>

        <div class="content-spacer"></div>
        <div class="footer">
          <div>Generated by: {{ generatedBy.name or generatedBy.id or 'System' }}</div>
          <div class="muted">Printed from AutoHub</div>
        </div>
      </div>
    </div>
      </div>
    </div>
      <script>
        (function(){
          try {
            const params = new URLSearchParams(window.location.search);
            if (params.get('autoPrint') === '1') {
              function doPrint(){
                try { window.print(); } catch(e){}
                // don't force-close; leaving optional
              }
              if (document.readyState === 'complete') doPrint();
              else window.addEventListener('load', doPrint);
            }
          } catch(e) {
            // silent
          }
        })();
      </script>
  </body>
</html>
