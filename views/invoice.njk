<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Invoice - {{ invoicePadded or invoice.number or '—' }}</title>
    <style>
      @page { size: Letter portrait; margin: 0.6in; }
      html,body{margin:0;padding:0;font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; color:#0f172a; -webkit-print-color-adjust:exact}
      body{ padding:18px}
      .sheet{max-width:800px;margin:0 auto;background:#fff;overflow:hidden}
      .container{padding:36px}

      /* Header */
      .top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
      .brand{display:flex;gap:16px;align-items:center}
      .logo{width:auto;min-width:120px;height:auto;border-radius:0;background:transparent;display:flex;align-items:center;justify-content:center;border:0}
      .logo img{max-width:160px;height:auto;border-radius:0;object-fit:contain;display:block}
      .company{font-size:14px;font-weight:700}
      .company .muted{display:block;color:#6b7280;font-weight:500;font-size:12px}

      .invoice-meta{text-align:right}
      .invoice-meta h2{margin:0;font-size:20px}
      .invoice-meta .muted{color:#6b7280;font-size:12px}

      hr.sep{border:0;border-top:1px solid #eef4ff;margin:18px 0}

      /* Customer info */
      .customer{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:4px}
      .customer .left{min-width:260px}
      .section-title{color:#6b7280;font-size:12px;margin-bottom:8px}

      /* Items table */
      table.items{width:100%;border-collapse:collapse;margin-top:14px}
      table.items thead th{background:#e7f0fb;color:#0f172a;text-align:left;padding:12px;font-weight:600;border-bottom:1px solid #dfeefb}
      table.items thead th.center, table.items tbody td.center { text-align:center }
      table.items thead th.right, table.items tbody td.right { text-align:right }
      table.items tbody td.right { font-variant-numeric: tabular-nums; }
      table.items tbody td{padding:14px 12px;border-bottom:1px solid #f1f6fb;vertical-align:top}
      .item-desc{color:#6b7280;font-size:13px}

      /* Totals */
      .totals{display:flex;justify-content:flex-end;margin-top:18px}
      .totals .box{width:320px}
      .totals .line{display:flex;justify-content:space-between;padding:10px 12px;border-bottom:1px solid #f1f6fb}
      .totals .line .k{color:#6b7280}
      .totals .total{font-weight:700}
      .balance-pill{display:inline-block;margin-top:12px;background:#eef6ff;padding:12px 16px;border-radius:8px;font-weight:800;color:#06266b;float:right}
    </style>
  </head>
  <body>
    <div class="sheet">
      <div class="container">
        <div class="top">
          <div class="brand">
            <div class="logo">
              <img src="{{ logoSrc }}" alt="AutoHub Express" style="max-width:160px;height:auto;border-radius:0;display:block;object-fit:contain"/>
            </div>
            <div>
              <div class="company">{{ 'RTX Recycling Inc' }}</div>
              <div class="muted">{{ '242 Monmouth Road' }}</div>
              <div class="muted">{{ 'Wrightstown,' }}</div>
              <div class="muted">{{ 'New Jersey 08562' }}</div>
              <div class="muted">{{ 'USA' }}</div>
              <div class="muted">{{ 'hello@autohub.express' }}</div>
              <div class="muted">Phone: {{ '+1 609 758 1919' }}</div>
            </div>
          </div>

          <div class="invoice-meta">
            {% set issueDate = invoiceDoc.invoiceDate or (checkIn and checkIn.checkInTime) or generatedAt %}
            {% set issueDateStr = '' %}
            {% if issueDate %}
              {% if issueDate.toLocaleDateString %}
                {% set issueDateStr = issueDate.toLocaleDateString('en-US') %}
              {% else %}
                {% set issueDateStr = issueDate | date('MMM DD, YYYY') %}
              {% endif %}
            {% endif %}
            {% if invoicePadded %}
              <h2>Invoice #{{ invoicePadded }}</h2>
            {% else %}
              <h2>Invoice{% if checkIn.checkInToken %} #{{ checkIn.checkInToken }}{% endif %}</h2>
            {% endif %}
            <div class="muted">Issue Date: {{ issueDateStr }}</div>
          </div>
        </div>

        <hr class="sep" />

        <div class="customer">
          <div class="left">
            {% set customerData = customer or (checkIn and checkIn.customer) %}
            <div class="section-title">Customer Info:</div>
            <div style="font-weight:700">{{ customerData.name or (customerData.firstName and customerData.lastName and (customerData.firstName ~ ' ' ~ customerData.lastName)) or '—' }}</div>
            <div class="muted">{{ customerData.email or '' }}</div>
            <div class="muted">Phone: {{ customerData.phone or customerData.mobileNo or '' }}</div>
            {% if customerData.address %}
              <div class="item-desc" style="margin-top:6px">{{ customerData.address }}</div>
            {% endif %}
          </div>
          <div class="right" style="min-width:220px">
            {% if checkIn %}
              <div class="section-title">Check-In Details:</div>
              <div class="muted">Token: {{ checkIn.checkInToken or '—' }}</div>
              <div class="muted">Persons: 1 + {{ checkIn.numberOfPersons or 0 }}</div>
              {% if checkIn.checkInTime %}
                {% set checkInTimeStr = '' %}
                {% if checkIn.checkInTime.toLocaleDateString %}
                  {% set checkInTimeStr = checkIn.checkInTime.toLocaleDateString('en-US') ~ ' ' ~ checkIn.checkInTime.toLocaleTimeString('en-US', {hour: '2-digit', minute: '2-digit'}) %}
                {% else %}
                  {% set checkInTimeStr = checkIn.checkInTime | date('MMM DD, YYYY HH:mm') %}
                {% endif %}
                <div class="muted">Time: {{ checkInTimeStr }}</div>
              {% endif %}
            {% endif %}
          </div>
        </div>

        <table class="items" role="table">
          <thead>
            <tr>
              <th style="width:52%">Product or Service</th>
              <th class="center" style="width:12%">Quantity</th>
              <th class="right" style="width:18%">Price</th>
              <th class="right" style="width:18%">Line Total</th>
            </tr>
          </thead>
          <tbody>
            {% if items and items | length %}
              {% for it in items %}
              <tr>
                <td>
                  <div>{{ it.name or it.description or 'Item' }}</div>
                  {% if it.description and it.name %}
                    <div class="item-desc">{{ it.description }}</div>
                  {% endif %}
                </td>
                <td class="center">{{ it.quantity or 1 }}</td>
                <td class="right">${{ (it.price or 0) | round(2) }}</td>
                <td class="right">${{ (it.lineTotal or (it.price * it.quantity) or 0) | round(2) }}</td>
              </tr>
              {% endfor %}
            {% else %}
              <tr>
                <td>
                  <div>Check-In Entry Fee</div>
                  <div class="item-desc">Facility access and browsing fee</div>
                </td>
                <td class="center">1</td>
                <td class="right">${{ (invoiceDoc and invoiceDoc.amount) or (transaction and transaction.amount) or 0 | round(2) }}</td>
                <td class="right">${{ (invoiceDoc and invoiceDoc.amount) or (transaction and transaction.amount) or 0 | round(2) }}</td>
              </tr>
            {% endif %}
          </tbody>
        </table>

        <div class="totals">
          <div class="box">
            <div class="line"><div class="k">Subtotal</div><div class="v">${{ (invoiceDoc and invoiceDoc.subtotal) or (transaction and transaction.amount) or 0 | round(2) }}</div></div>
            <div class="line"><div class="k">Taxes</div><div class="v">${{ (invoiceDoc and invoiceDoc.taxAmount) or 0 | round(2) }}</div></div>
            <div class="line"><div class="k">&nbsp;</div><div class="v" style="height:8px"></div></div>
            <div class="line"><div class="k">Total</div><div class="v total">${{ (invoiceDoc and invoiceDoc.total) or (transaction and transaction.amount) or 0 | round(2) }}</div></div>
            <div class="line"><div class="k">Amount Paid</div><div class="v">${{ (invoiceDoc and invoiceDoc.amountPaid) or (transaction and transaction.amount) or 0 | round(2) }}</div></div>
            <div style="padding:12px">
              {% set balance = (invoiceDoc and invoiceDoc.balanceDue) or 0 %}
              <div class="balance-pill">Balance Due&nbsp;&nbsp;${{ balance | round(2) }}</div>
            </div>
          </div>
        </div>

        <div style="clear:both"></div>
        
      </div>
    </div>

    <script>
      (function(){
        try{
          const params = new URLSearchParams(window.location.search);
          if (params.get('autoPrint') === '1'){
            function p(){ try{ window.print() }catch(e){} }
            if (document.readyState === 'complete') p(); else window.addEventListener('load', p);
          }
        }catch(e){}
      })();
    </script>
  </body>
</html>
